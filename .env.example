# ==============================================================================
# DIGITAL PRODUCT STORE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values
# ==============================================================================

# === Database (Supabase PostgreSQL via Supavisor Pooler, Port 6543) ===
DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# === Supabase Storage (Public covers & Private assets) ===
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# === NextAuth v5 (Auth.js) ===
AUTH_SECRET="your-32-byte-base64-secret-key-here" # Generate with: openssl rand -base64 32
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
AUTH_TRUST_HOST="true"

# === Initial Admin Bootstrap (Comma-separated emails) ===
ADMIN_EMAILS="admin@yourdomain.com,owner@yourdomain.com"

# === Sepay Payment Gateway (VietQR Bank Transfer) ===
SEPAY_BANK="MBBank"
SEPAY_ACCOUNT="0123456789"
SEPAY_ACCOUNT_NAME="NGUYEN VAN A"
SEPAY_WEBHOOK_SECRET="your-sepay-webhook-secret-key"

# === Referral System ===
REFERRAL_RATE="0.1" # 10% commission rate

# === Rate Limiting (Upstash Redis Free Tier) ===
UPSTASH_REDIS_REST_URL="https://[YOUR-DB].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# === Transactional Email (Resend) ===
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Digital Store <orders@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"

# === Observability (Sentry & Analytics) ===
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# === Security Salts (For PII Anonymization & Token Security) ===
IP_SALT="random-32-character-secret-salt-for-ip-hashing"
DOWNLOAD_IP_SALT="different-random-salt-for-downloads"

# === Site & Branding Metadata ===
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Digital Forge"
NEXT_PUBLIC_CONTACT_EMAIL="hello@digitalforge.vn"
NEXT_PUBLIC_BUSINESS_NAME="CÔNG TY TNHH DIGITAL FORGE"
NEXT_PUBLIC_BUSINESS_TAX_ID="0123456789"
NEXT_PUBLIC_BUSINESS_ADDRESS="Hà Nội, Việt Nam"
