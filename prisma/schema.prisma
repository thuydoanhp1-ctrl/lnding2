generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  active
  blocked
}

enum ProductStatus {
  draft
  published
  archived
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
  expired
}

enum LicenseType {
  personal
  team
  commercial
  extended
}

enum ReviewStatus {
  pending
  published
  hidden
}

enum ReferralStatus {
  pending
  confirmed
  rejected
}

enum CouponType {
  percent
  fixed
}

enum AuditAction {
  create
  update
  delete
  confirm
  reject
  revoke
  download_revoke
  admin_grant
  admin_revoke
}

// ==========================================
// AUTH (NextAuth v5 Standard Models)
// ==========================================

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus @default(active)
  isAdmin       Boolean    @default(false)
  referralCode  String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  accounts     Account[]
  sessions     Session[]
  orders       Order[]
  reviews      Review[]
  referrals    Referral[]    @relation("ReferrerReferrals")
  auditLogs    AuditLog[]
  couponUsages CouponUsage[]

  @@index([email])
  @@index([referralCode])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// CATALOG & PRODUCTS
// ==========================================

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String? // Lucide icon name or emoji
  order       Int       @default(0)
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([slug])
  @@index([order])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  shortDescription String?
  longDescription  String?       @db.Text // Markdown description
  coverImage       String?
  gallery          String[]      // Array of Supabase public URLs
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  tags             String[]
  status           ProductStatus @default(draft)
  featured         Boolean       @default(false)
  basePrice        Int           // VND for "from" price
  salesCount       Int           @default(0)
  ratingAvg        Float?
  ratingCount      Int           @default(0)
  metaTitle        String?       // SEO override
  metaDescription  String?
  ogImage          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  deletedAt        DateTime?

  variants   ProductVariant[]
  assets     ProductAsset[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([status, featured, createdAt])
  @@index([categoryId, status])
  @@index([slug])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  code           String      // PERSONAL | TEAM | COMMERCIAL | EXTENDED
  name           String      // "Cá nhân", "Đội nhóm", "Thương mại"
  description    String?
  price          Int         // VND
  comparePrice   Int?        // Original price (crossed out)
  licenseType    LicenseType
  maxDownloads   Int?        // null = unlimited
  downloadExpiry Int?        // days after purchase, null = unlimited
  available      Boolean     @default(true)
  order          Int         @default(0)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  assetMappings  ProductAssetVariant[]

  @@unique([productId, code])
  @@index([productId, available])
}

model ProductAsset {
  id             String   @id @default(cuid())
  productId      String
  name           String   // Displayed in user library
  filename       String   // Original filename
  storagePath    String   // Path in Supabase private bucket "product-assets"
  sizeBytes      BigInt
  mimeType       String
  checksumSha256 String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantMappings ProductAssetVariant[]
  downloadTokens  DownloadToken[]

  @@index([productId])
}

model ProductAssetVariant {
  assetId   String
  variantId String
  asset     ProductAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([assetId, variantId])
}

// ==========================================
// ORDERS & DOWNLOAD TOKENS
// ==========================================

model Order {
  id           String      @id @default(cuid())
  publicCode   String      @unique // e.g. "ORD-A7K9X2"
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerName    String
  buyerEmail   String
  buyerPhone   String?
  subtotal     Int
  discount     Int         @default(0)
  total        Int
  status       OrderStatus @default(pending)
  paymentMemo  String      // Memo for Sepay VietQR transfer
  paidAt       DateTime?
  paidBy       String?     // Admin user ID if manually confirmed
  cancelledAt  DateTime?
  expiresAt    DateTime    // Pending orders expire after 24h
  couponCode   String?
  referralCode String?     // Source referral code tracking
  ipAddress    String?
  userAgent    String?
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items          OrderItem[]
  downloadTokens DownloadToken[]
  referral       Referral?
  couponUsage    CouponUsage?

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@index([buyerEmail])
  @@index([publicCode])
}

model OrderItem {
  id               String      @id @default(cuid())
  orderId          String
  productId        String
  variantId        String
  productTitleSnap String      // Snapshot of product title at purchase
  variantNameSnap  String      // Snapshot of variant name
  priceSnap        Int         // Snapshot of price
  licenseSnap      LicenseType
  maxDownloadsSnap Int?
  expiryDaysSnap   Int?

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  downloadTokens DownloadToken[]

  @@index([orderId])
}

model DownloadToken {
  id             String    @id @default(cuid())
  token          String    @unique // 32-byte hex token in URL
  orderId        String
  orderItemId    String
  assetId        String
  downloadCount  Int       @default(0)
  maxDownloads   Int       // -1 = unlimited
  expiresAt      DateTime
  lastDownloadAt DateTime?
  lastIpHash     String?   // sha256(ip + secret), no raw IP stored
  revoked        Boolean   @default(false)
  revokedReason  String?
  createdAt      DateTime  @default(now())

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  asset     ProductAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([orderId])
  @@index([orderItemId])
}

// ==========================================
// COUPONS & DISCOUNTS
// ==========================================

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Int        // Percent: 1-100, Fixed: VND
  minOrderAmount Int?
  maxDiscount    Int?       // Cap for percent discounts
  usageLimit     Int?       // Total max usages
  usageCount     Int        @default(0)
  perUserLimit   Int?
  productIds     String[]   // Empty = applies to all products
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  usages CouponUsage[]

  @@index([code, active])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?
  discount  Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
}

// ==========================================
// REVIEWS & RATINGS
// ==========================================

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String
  orderId          String?      // Links to verified purchase order
  rating           Int          // 1..5
  title            String?
  body             String?      @db.Text
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(pending)
  createdAt        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // 1 user review per product
  @@index([productId, status])
}

// ==========================================
// REFERRAL & AFFILIATE SYSTEM
// ==========================================

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referralCode String
  orderId      String?        @unique
  buyerName    String
  buyerEmail   String?
  buyerPhone   String?
  amount       Int            // Base order total
  commission   Int            // Calculated commission (e.g. 10%)
  status       ReferralStatus @default(pending)
  note         String?
  createdAt    DateTime       @default(now())
  confirmedAt  DateTime?
  confirmedBy  String?

  referrer User   @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([referrerId, status])
  @@index([status, createdAt])
}

// ==========================================
// AUDIT LOGS & OBSERVABILITY
// ==========================================

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String      // "Product" | "Order" | "User" | "Coupon"
  entityId   String
  metadata   Json
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
